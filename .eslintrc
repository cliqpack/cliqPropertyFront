{
  "extends": ["plugin:react/recommended"],
  "rules": {
    "no-undef": "off",
    "react/prop-types": "off",
    "react/react-in-jsx-scope": "off" // <-- Add this line
  },
  "settings": {
    "react": {
      "version": "detect" // Auto-detect the React version
    }
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  }
}
